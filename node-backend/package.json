{
  "name": "talaeats-node-native-staging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run preflight && npm run generate && npm run db:validate && npm run build && npm test",
    "release:stage:check": "node scripts/release-readiness.mjs --stage",
    "release:production:check": "node scripts/release-readiness.mjs --production",
    "smoke:stage": "node scripts/stage-readonly-smoke.mjs",
    "finance:stage:gate": "node dist/finance/rc7-financial-gate.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "5.61.2",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "pg": "8.16.3",
    "stripe": "23.0.0",
    "zod": "4.1.12",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.9.1",
    "@types/pg": "8.15.5",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "@types/web-push": "3.6.4"
  }
}
