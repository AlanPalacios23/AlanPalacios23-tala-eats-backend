# Staging-only; unique credentials, NEVER copy LIVE.
NODE_ENV=staging
HOST=127.0.0.1
PORT=18190
DATABASE_URL=postgresql://tala_node_stage:REPLACE_PASSWORD_URLENCODED@127.0.0.1:15435/tala_node_stage
REDIS_URL=redis://:REPLACE_PASSWORD_URLENCODED@127.0.0.1:16379/0
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_FINANCIAL_WRITES_ENABLED=false

# Auth V02 remains OFF until optional stage-only migration + QA.
AUTH_V02_ENABLED=false
# AUTH_JWT_SECRET=GENERATE_UNIQUE_STAGE_RANDOM_SECRET_MIN_40_CHARS

# Phase B isolated schema: enable only after PG15 stage migration + CI.
MARKETPLACE_B_ENABLED=false

# CASH/PICKUP ONLY synthetic checkout, never enable on live traffic.
STAGE_PICKUP_CASH_CHECKOUT_ENABLED=false

# Customer addresses/favorites/notifications; isolated PG15 stage only.
PLATFORM_E1_ENABLED=false
