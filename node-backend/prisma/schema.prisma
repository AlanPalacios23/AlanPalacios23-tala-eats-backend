generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum PayoutStatus {
  DRAFT
  REQUIRES_REVIEW
  APPROVED
  SUBMITTED
  RECONCILING
  COMPLETED
  FAILED
}

model StripeWebhookEvent {
  id              String        @id
  type            String
  stripeAccountId String?
  objectId        String?
  status          WebhookStatus @default(RECEIVED)
  deliveryCount   Int           @default(1)
  receivedAt      DateTime      @default(now())
  processedAt     DateTime?
  lastErrorAt     DateTime?
  @@index([status, receivedAt])
  @@map("stripe_webhook_events")
}

model MerchantConnectAccount {
  id              String   @id @default(uuid())
  merchantId      String   @unique
  stripeAccountId String   @unique
  chargesEnabled  Boolean  @default(false)
  payoutsEnabled  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@map("merchant_connect_accounts")
}

// Diseño de conciliación, nunca ejecuta pagos en v0.1.0.
model PayoutInstruction {
  id               String       @id @default(uuid())
  merchantId       String
  amountMinor      BigInt
  currency         String       @default("mxn")
  idempotencyKey   String       @unique
  stripePayoutId   String?      @unique
  status           PayoutStatus @default(DRAFT)
  lastReconciledAt DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  @@index([merchantId, status])
  @@map("payout_instructions")
}

// Phase A: fresh ISOLATED Node stage tables mapped to Python auth contracts.
// Never use these migrations against the Python V3/Green production DB.
model AuthUser {
  id                    Int                @id @default(autoincrement())
  name                  String             @db.VarChar(120)
  email                 String             @unique @db.VarChar(255)
  passwordHash          String?            @map("password_hash") @db.VarChar(500)
  role                  String             @default("customer") @db.VarChar(30)
  authProvider          String             @default("local") @map("auth_provider") @db.VarChar(30)
  googleSub             String?            @unique @map("google_sub") @db.VarChar(255)
  avatarUrl             String?            @map("avatar_url") @db.VarChar(600)
  phone                 String             @default("") @db.VarChar(30)
  isActive              Boolean            @default(true) @map("is_active")
  twoFactorEnabled      Boolean            @default(false) @map("two_factor_enabled")
  totpSecret            String             @default("") @map("totp_secret") @db.VarChar(80)
  marketingOptIn        Boolean            @default(true) @map("marketing_opt_in")
  analyticsOptIn        Boolean            @default(true) @map("analytics_opt_in")
  personalizationOptIn  Boolean            @default(true) @map("personalization_opt_in")
  birthDate             String             @default("") @map("birth_date") @db.VarChar(10)
  createdAt             DateTime           @default(now()) @map("created_at")
  sessions              AuthDeviceSession[]
  loyalty               AuthLoyaltyAccount?
  notifications         AuthNotification[]
  audits                AuthAuditEvent[]
  resets                AuthPasswordResetToken[]
  @@index([role])
  @@map("users")
}

model AuthDeviceSession {
  id              Int             @id @default(autoincrement())
  userId          Int             @map("user_id")
  sessionHash     String          @unique @map("session_hash") @db.VarChar(64)
  deviceIdHash    String          @default("") @map("device_id_hash") @db.VarChar(64)
  deviceLabel     String          @default("") @map("device_label") @db.VarChar(200)
  platform        String          @default("unknown") @db.VarChar(40)
  ipHint          String          @default("") @map("ip_hint") @db.VarChar(80)
  riskScore       Int             @default(0) @map("risk_score")
  trusted         Boolean         @default(false)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")
  lastSeenAt      DateTime        @default(now()) @map("last_seen_at")
  user            AuthUser        @relation(fields:[userId],references:[id],onDelete:Cascade)
  audits          AuthAuditEvent[]
  @@index([userId, createdAt])
  @@index([deviceIdHash])
  @@map("device_sessions")
}

model AuthLoyaltyAccount {
  id             Int        @id @default(autoincrement())
  userId         Int        @unique @map("user_id")
  points         Int        @default(0)
  tier           String     @default("BRONZE") @db.VarChar(20)
  streakDays     Int        @default(0) @map("streak_days")
  plusSavings    Decimal    @default(0.00) @map("plus_savings") @db.Decimal(10,2)
  walletBalance  Decimal    @default(0.00) @map("wallet_balance") @db.Decimal(10,2)
  plusMember     Boolean    @default(false) @map("plus_member")
  referralCode   String     @unique @map("referral_code") @db.VarChar(20)
  user           AuthUser   @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@map("loyalty_accounts")
}

model AuthNotification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  kind        String   @default("system") @db.VarChar(50)
  title       String   @db.VarChar(150)
  message     String   @db.VarChar(500)
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")
  user        AuthUser @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId, createdAt])
  @@map("notifications")
}

model AuthAuditEvent {
  id              Int                @id @default(autoincrement())
  userId          Int?               @map("user_id")
  action          String             @db.VarChar(100)
  entityType      String             @default("") @map("entity_type") @db.VarChar(80)
  entityId        String             @default("") @map("entity_id") @db.VarChar(120)
  detail          String             @default("")
  beforeJson      String             @default("{}") @map("before_json")
  afterJson       String             @default("{}") @map("after_json")
  createdAt       DateTime           @default(now()) @map("created_at")
  deviceSessionId Int?               @map("device_session_id")
  user            AuthUser?          @relation(fields:[userId],references:[id],onDelete:SetNull)
  session         AuthDeviceSession? @relation(fields:[deviceSessionId],references:[id],onDelete:SetNull)
  @@index([userId, createdAt])
  @@map("audit_events")
}

model AuthPasswordResetToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       AuthUser  @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuthEmailOutbox {
  id          Int       @id @default(autoincrement())
  toEmail     String    @map("to_email") @db.VarChar(255)
  subject     String    @db.VarChar(220)
  textBody    String    @map("text_body")
  status      String    @default("pending") @db.VarChar(30)
  attempts    Int       @default(0)
  lastError   String    @default("") @map("last_error") @db.VarChar(500)
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  @@index([status, createdAt])
  @@map("email_outbox")
}
