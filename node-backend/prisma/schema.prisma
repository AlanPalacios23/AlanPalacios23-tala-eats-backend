generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum PayoutStatus {
  DRAFT
  REQUIRES_REVIEW
  APPROVED
  SUBMITTED
  RECONCILING
  COMPLETED
  FAILED
}

model StripeWebhookEvent {
  id              String        @id
  type            String
  stripeAccountId String?
  objectId        String?
  status          WebhookStatus @default(RECEIVED)
  deliveryCount   Int           @default(1)
  receivedAt      DateTime      @default(now())
  processedAt     DateTime?
  lastErrorAt     DateTime?
  @@index([status, receivedAt])
  @@map("stripe_webhook_events")
}

model MerchantConnectAccount {
  id              String   @id @default(uuid())
  merchantId      String   @unique
  stripeAccountId String   @unique
  chargesEnabled  Boolean  @default(false)
  payoutsEnabled  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@map("merchant_connect_accounts")
}

// Diseño de conciliación, nunca ejecuta pagos en v0.1.0.
model PayoutInstruction {
  id               String       @id @default(uuid())
  merchantId       String
  amountMinor      BigInt
  currency         String       @default("mxn")
  idempotencyKey   String       @unique
  stripePayoutId   String?      @unique
  status           PayoutStatus @default(DRAFT)
  lastReconciledAt DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  @@index([merchantId, status])
  @@map("payout_instructions")
}

// Phase A: fresh ISOLATED Node stage tables mapped to Python auth contracts.
// Never use these migrations against the Python V3/Green production DB.
model AuthUser {
  id                    Int                @id @default(autoincrement())
  name                  String             @db.VarChar(120)
  email                 String             @unique @db.VarChar(255)
  passwordHash          String?            @map("password_hash") @db.VarChar(500)
  role                  String             @default("customer") @db.VarChar(30)
  authProvider          String             @default("local") @map("auth_provider") @db.VarChar(30)
  googleSub             String?            @unique @map("google_sub") @db.VarChar(255)
  avatarUrl             String?            @map("avatar_url") @db.VarChar(600)
  phone                 String             @default("") @db.VarChar(30)
  isActive              Boolean            @default(true) @map("is_active")
  twoFactorEnabled      Boolean            @default(false) @map("two_factor_enabled")
  totpSecret            String             @default("") @map("totp_secret") @db.VarChar(80)
  marketingOptIn        Boolean            @default(true) @map("marketing_opt_in")
  analyticsOptIn        Boolean            @default(true) @map("analytics_opt_in")
  personalizationOptIn  Boolean            @default(true) @map("personalization_opt_in")
  birthDate             String             @default("") @map("birth_date") @db.VarChar(10)
  createdAt             DateTime           @default(now()) @map("created_at")
  sessions              AuthDeviceSession[]
  loyalty               AuthLoyaltyAccount?
  notifications         AuthNotification[]
  customerAddresses     PlatformAddress[]
  restaurantFavorites   PlatformFavorite[]
  audits                AuthAuditEvent[]
  resets                AuthPasswordResetToken[]
  marketRestaurants     MarketplaceRestaurant[]
  marketOrders          MarketOrder[] @relation("CustomerOrders")
  assignedOrders        MarketOrder[] @relation("DriverOrders")
  driverProfile         MarketplaceDriverProfile?
  restaurantEmployment  MarketplaceRestaurantEmployee[]
  authoredReviews       PlatformReview[] @relation("ReviewAuthor")
  driverReviews         PlatformReview[] @relation("ReviewDriver")
  @@index([role])
  @@map("users")
}

model AuthDeviceSession {
  id              Int             @id @default(autoincrement())
  userId          Int             @map("user_id")
  sessionHash     String          @unique @map("session_hash") @db.VarChar(64)
  deviceIdHash    String          @default("") @map("device_id_hash") @db.VarChar(64)
  deviceLabel     String          @default("") @map("device_label") @db.VarChar(200)
  platform        String          @default("unknown") @db.VarChar(40)
  ipHint          String          @default("") @map("ip_hint") @db.VarChar(80)
  riskScore       Int             @default(0) @map("risk_score")
  trusted         Boolean         @default(false)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")
  lastSeenAt      DateTime        @default(now()) @map("last_seen_at")
  user            AuthUser        @relation(fields:[userId],references:[id],onDelete:Cascade)
  audits          AuthAuditEvent[]
  @@index([userId, createdAt])
  @@index([deviceIdHash])
  @@map("device_sessions")
}

model AuthLoyaltyAccount {
  id             Int        @id @default(autoincrement())
  userId         Int        @unique @map("user_id")
  points         Int        @default(0)
  tier           String     @default("BRONZE") @db.VarChar(20)
  streakDays     Int        @default(0) @map("streak_days")
  plusSavings    Decimal    @default(0.00) @map("plus_savings") @db.Decimal(10,2)
  walletBalance  Decimal    @default(0.00) @map("wallet_balance") @db.Decimal(10,2)
  plusMember     Boolean    @default(false) @map("plus_member")
  referralCode   String     @unique @map("referral_code") @db.VarChar(20)
  user           AuthUser   @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@map("loyalty_accounts")
}

model AuthNotification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  kind        String   @default("system") @db.VarChar(50)
  title       String   @db.VarChar(150)
  message     String   @db.VarChar(500)
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")
  user        AuthUser @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId, createdAt])
  @@map("notifications")
}

model AuthAuditEvent {
  id              Int                @id @default(autoincrement())
  userId          Int?               @map("user_id")
  action          String             @db.VarChar(100)
  entityType      String             @default("") @map("entity_type") @db.VarChar(80)
  entityId        String             @default("") @map("entity_id") @db.VarChar(120)
  detail          String             @default("")
  beforeJson      String             @default("{}") @map("before_json")
  afterJson       String             @default("{}") @map("after_json")
  createdAt       DateTime           @default(now()) @map("created_at")
  deviceSessionId Int?               @map("device_session_id")
  user            AuthUser?          @relation(fields:[userId],references:[id],onDelete:SetNull)
  session         AuthDeviceSession? @relation(fields:[deviceSessionId],references:[id],onDelete:SetNull)
  @@index([userId, createdAt])
  @@map("audit_events")
}

model AuthPasswordResetToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       AuthUser  @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuthEmailOutbox {
  id          Int       @id @default(autoincrement())
  toEmail     String    @map("to_email") @db.VarChar(255)
  subject     String    @db.VarChar(220)
  textBody    String    @map("text_body")
  status      String    @default("pending") @db.VarChar(30)
  attempts    Int       @default(0)
  lastError   String    @default("") @map("last_error") @db.VarChar(500)
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  @@index([status, createdAt])
  @@map("email_outbox")
}

 
// Phase B: dedicated STAGING ONLY. Contract names + numeric IDs mirror Python.
// Financial state is inspect-only: checkout, payouts and ledger are deliberately
// not connected to these models until atomic accounting/dispatch parity exists.
model MarketplaceRestaurant {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(150)
  description       String   @default("")
  cuisine           String   @default("Comida local") @db.VarChar(100)
  emoji             String   @default("🍽️") @db.VarChar(20)
  etaMin            Int      @default(30) @map("eta_min")
  deliveryFee       Decimal  @default(0) @map("delivery_fee") @db.Decimal(10,2)
  isOpen            Boolean  @default(true) @map("is_open")
  ownerId           Int?     @map("owner_id")
  lat               Float    @default(20.6534)
  lng               Float    @default(-103.704)
  address           String   @default("") @db.VarChar(300)
  deliveryRadiusKm  Float    @default(8) @map("delivery_radius_km")
  perKmFee          Decimal  @default(4) @map("per_km_fee") @db.Decimal(10,2)
  pickupEnabled     Boolean  @default(true) @map("pickup_enabled")
  sponsored         Boolean  @default(false)
  rating            Decimal  @default(4.80) @db.Decimal(3,2)
  verificationStatus String  @default("verified") @map("verification_status") @db.VarChar(30)
  posWebhookUrl     String   @default("") @map("pos_webhook_url") @db.VarChar(600)
  taxId             String   @default("") @map("tax_id") @db.VarChar(40)
  commercialPlan    String   @default("START") @map("commercial_plan") @db.VarChar(30)
  commissionRate    Decimal  @default(0.1200) @map("commission_rate") @db.Decimal(6,4)
  serviceFeeRate    Decimal  @default(0.0400) @map("service_fee_rate") @db.Decimal(6,4)
  serviceFeeFixed   Decimal  @default(0) @map("service_fee_fixed") @db.Decimal(10,2)
  branchCode        String   @default("MAIN") @map("branch_code") @db.VarChar(40)
  brandName         String   @default("") @map("brand_name") @db.VarChar(150)
  marketCode        String   @default("TALA-JAL") @map("market_code") @db.VarChar(40)
  onboardingStatus  String   @default("approved") @map("onboarding_status") @db.VarChar(30)
  coverImageUrl     String   @default("") @map("cover_image_url") @db.VarChar(600)
  createdAt         DateTime @default(now()) @map("created_at")
  owner             AuthUser? @relation(fields:[ownerId],references:[id],onDelete:SetNull)
  menuItems         MarketplaceMenuItem[]
  favoritedBy       PlatformFavorite[]
  promotions        PlatformPromotion[]
  reviews           PlatformReview[]
  employees         MarketplaceRestaurantEmployee[]
  orders            MarketOrder[]
  @@index([ownerId])
  @@index([marketCode])
  @@index([isOpen, name])
  @@map("restaurants")
}

model MarketplaceMenuItem {
  id                        Int      @id @default(autoincrement())
  restaurantId              Int      @map("restaurant_id")
  name                      String   @db.VarChar(150)
  description               String   @default("")
  category                  String   @default("General") @db.VarChar(100)
  price                     Decimal  @db.Decimal(10,2)
  isAvailable               Boolean  @default(true) @map("is_available")
  stock                     Int      @default(100)
  dietaryTags               String   @default("") @map("dietary_tags") @db.VarChar(300)
  allergens                 String   @default("") @db.VarChar(300)
  isCombo                   Boolean  @default(false) @map("is_combo")
  optionsJson               String   @default("[]") @map("options_json")
  availabilityScheduleJson  String   @default("{}") @map("availability_schedule_json")
  priceScheduleJson         String   @default("{}") @map("price_schedule_json")
  imageUrl                  String   @default("") @map("image_url") @db.VarChar(600)
  restaurant                MarketplaceRestaurant @relation(fields:[restaurantId],references:[id],onDelete:Cascade)
  orderItems                MarketOrderItem[]
  @@index([restaurantId])
  @@map("menu_items")
}

model MarketplaceDriverProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique @map("user_id")
  vehicle         String   @default("Motocicleta") @db.VarChar(80)
  plate           String   @default("") @db.VarChar(30)
  isOnline        Boolean  @default(false) @map("is_online")
  isVerified      Boolean  @default(false) @map("is_verified")
  rating          Decimal  @default(5.00) @db.Decimal(3,2)
  totalDeliveries Int      @default(0) @map("total_deliveries")
  currentLat      Float?   @map("current_lat")
  currentLng      Float?   @map("current_lng")
  earningsToday   Decimal  @default(0) @map("earnings_today") @db.Decimal(10,2)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  user            AuthUser @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([isOnline])
  @@map("driver_profiles")
}

model MarketOrder {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @map("user_id")
  restaurantId           Int      @map("restaurant_id")
  driverId               Int?     @map("driver_id")
  status                 String   @default("received") @db.VarChar(40)
  paymentMethod          String   @default("cash") @map("payment_method") @db.VarChar(30)
  paymentStatus          String   @default("pending") @map("payment_status") @db.VarChar(30)
  paymentProvider        String   @default("") @map("payment_provider") @db.VarChar(30)
  paymentProviderId      String   @default("") @map("payment_provider_id") @db.VarChar(120)
  paymentPreferenceId    String   @default("") @map("payment_preference_id") @db.VarChar(160)
  subtotal               Decimal  @default(0) @db.Decimal(10,2)
  deliveryFee            Decimal  @default(0) @map("delivery_fee") @db.Decimal(10,2)
  discount               Decimal  @default(0) @db.Decimal(10,2)
  tip                    Decimal  @default(0) @db.Decimal(10,2)
  total                  Decimal  @default(0) @db.Decimal(10,2)
  platformCommission     Decimal  @default(0) @map("platform_commission") @db.Decimal(10,2)
  serviceFee             Decimal  @default(0) @map("service_fee") @db.Decimal(10,2)
  paymentProcessingFee   Decimal  @default(0) @map("payment_processing_fee") @db.Decimal(10,2)
  refundedAmount         Decimal  @default(0) @map("refunded_amount") @db.Decimal(10,2)
  promotionSubsidy       Decimal  @default(0) @map("promotion_subsidy") @db.Decimal(10,2)
  platformRevenue        Decimal  @default(0) @map("platform_revenue") @db.Decimal(10,2)
  contributionMargin     Decimal  @default(0) @map("contribution_margin") @db.Decimal(10,2)
  cashCollected          Decimal  @default(0) @map("cash_collected") @db.Decimal(10,2)
  cancellationFee        Decimal  @default(0) @map("cancellation_fee") @db.Decimal(10,2)
  restaurantPayout       Decimal  @default(0) @map("restaurant_payout") @db.Decimal(10,2)
  driverEarning          Decimal  @default(0) @map("driver_earning") @db.Decimal(10,2)
  address                String   @db.VarChar(300)
  notes                  String   @default("")
  deliveryPin            String   @default("") @map("delivery_pin") @db.VarChar(4)
  orderType              String   @default("delivery") @map("order_type") @db.VarChar(20)
  scheduledFor           DateTime? @map("scheduled_for")
  couponCode             String   @default("") @map("coupon_code") @db.VarChar(50)
  groupCode              String   @default("") @map("group_code") @db.VarChar(12)
  recipientName          String   @default("") @map("recipient_name") @db.VarChar(120)
  recipientPhone         String   @default("") @map("recipient_phone") @db.VarChar(40)
  giftMessage            String   @default("") @map("gift_message") @db.VarChar(300)
  corporateAccountId     Int?     @map("corporate_account_id")
  distanceKm             Float    @default(2.5) @map("distance_km")
  deliveryLat            Float?   @map("delivery_lat")
  deliveryLng            Float?   @map("delivery_lng")
  estimatedMinutes       Int      @default(30) @map("estimated_minutes")
  invoiceRequested       Boolean  @default(false) @map("invoice_requested")
  invoiceTaxId           String   @default("") @map("invoice_tax_id") @db.VarChar(40)
  clientReference        String?  @map("client_reference") @db.VarChar(80)
  inventoryReservedJson  String   @default("{}") @map("inventory_reserved_json")
  inventoryRestoredAt    DateTime? @map("inventory_restored_at")
  cancelledReason       String   @default("") @map("cancelled_reason") @db.VarChar(300)
  acceptedAt             DateTime? @map("accepted_at")
  preparingAt            DateTime? @map("preparing_at")
  readyAt                DateTime? @map("ready_at")
  pickedUpAt             DateTime? @map("picked_up_at")
  deliveredAt            DateTime? @map("delivered_at")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")
  customer               AuthUser @relation("CustomerOrders",fields:[userId],references:[id])
  driver                 AuthUser? @relation("DriverOrders",fields:[driverId],references:[id])
  restaurant             MarketplaceRestaurant @relation(fields:[restaurantId],references:[id])
  items                  MarketOrderItem[]
  reviews                PlatformReview[]
  @@unique([userId,clientReference],name:"uq_order_user_client_reference")
  @@index([userId,createdAt])
  @@index([restaurantId,status])
  @@index([driverId,status])
  @@map("orders")
}

model MarketOrderItem {
  id               Int     @id @default(autoincrement())
  orderId          Int     @map("order_id")
  menuItemId       Int?    @map("menu_item_id")
  nameSnapshot     String  @map("name_snapshot") @db.VarChar(150)
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(10,2)
  optionsSnapshot  String  @default("") @map("options_snapshot")
  order            MarketOrder @relation(fields:[orderId],references:[id],onDelete:Cascade)
  menuItem         MarketplaceMenuItem? @relation(fields:[menuItemId],references:[id],onDelete:SetNull)
  @@index([orderId])
  @@map("order_items")
}


// Phase C stage-only test cash-pickup checkout. Financial audit rows have
// append-only semantics; the migration creates DB triggers forbidding
// UPDATE/DELETE to emulate the Python immutable ledger.
model StageOrderEvent {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  status      String   @db.VarChar(40)
  actorUserId Int?     @map("actor_user_id")
  metadataJson String  @default("{}") @map("metadata_json")
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([orderId])
  @@index([status])
  @@map("order_events")
}
model StageFinancialLedgerEntry {
  id               Int      @id @default(autoincrement())
  orderId          Int?     @map("order_id")
  userId           Int?     @map("user_id")
  restaurantId     Int?     @map("restaurant_id")
  account          String   @db.VarChar(60)
  direction        String   @default("credit") @db.VarChar(10)
  amount           Decimal  @default(0) @db.Decimal(12,2)
  currency         String   @default("MXN") @db.VarChar(8)
  kind             String   @db.VarChar(60)
  description      String   @default("") @db.VarChar(300)
  idempotencyKey   String   @unique @map("idempotency_key") @db.VarChar(180)
  createdAt        DateTime @default(now()) @map("created_at")
  @@index([orderId])
  @@index([userId])
  @@index([restaurantId])
  @@index([account])
  @@index([kind])
  @@index([createdAt])
  @@map("financial_ledger_entries")
}
model StageEventOutbox {
  id            Int      @id @default(autoincrement())
  eventKey      String   @unique @map("event_key") @db.VarChar(220)
  aggregateType String   @map("aggregate_type") @db.VarChar(60)
  aggregateId   String   @map("aggregate_id") @db.VarChar(120)
  eventType     String   @map("event_type") @db.VarChar(120)
  payloadJson   String   @default("{}") @map("payload_json")
  status        String   @default("pending") @db.VarChar(30)
  attempts      Int      @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at")
  lockedAt      DateTime? @map("locked_at")
  lastError     String   @default("") @map("last_error") @db.VarChar(1000)
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime @default(now()) @map("created_at")
  @@index([eventKey])
  @@index([aggregateType])
  @@index([aggregateId])
  @@index([eventType])
  @@index([status])
  @@index([nextAttemptAt])
  @@index([publishedAt])
  @@index([createdAt])
  @@map("event_outbox")
}
model StageIngredientStock {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  name         String   @db.VarChar(140)
  unit         String   @default("unit") @db.VarChar(30)
  quantity     Decimal  @default(0) @db.Decimal(12,3)
  reorderLevel Decimal  @default(0) @map("reorder_level") @db.Decimal(12,3)
  unitCost     Decimal  @default(0) @map("unit_cost") @db.Decimal(10,2)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  @@index([restaurantId])
  @@index([name])
  @@map("ingredient_stocks")
}
model StageMenuRecipe {
  id               Int      @id @default(autoincrement())
  menuItemId       Int      @map("menu_item_id")
  ingredientId     Int      @map("ingredient_id")
  quantityRequired Decimal  @default(1) @map("quantity_required") @db.Decimal(12,3)
  @@unique([menuItemId,ingredientId],name:"uq_recipe_component")
  @@index([menuItemId])
  @@index([ingredientId])
  @@map("menu_recipes")
}

// C3 isolated cash-pickup completion. No third-party PSP, driver dispatch,
// external payout or real-world proof persistence.
model StageDeliveryProof {
  id          Int      @id @default(autoincrement())
  orderId     Int      @unique @map("order_id")
  driverId    Int      @map("driver_id")
  pinVerified Boolean  @default(false) @map("pin_verified")
  photoUrl    String   @default("") @map("photo_url") @db.VarChar(600)
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now()) @map("created_at")
  @@index([driverId])
  @@map("delivery_proofs")
}
model StageProductEvent {
  id             Int      @id @default(autoincrement())
  userId         Int?     @map("user_id")
  sessionId      String   @default("") @map("session_id") @db.VarChar(80)
  eventName      String   @map("event_name") @db.VarChar(100)
  route          String   @default("") @db.VarChar(240)
  propertiesJson String   @default("{}") @map("properties_json")
  createdAt      DateTime @default(now()) @map("created_at")
  @@index([userId])
  @@index([sessionId])
  @@index([eventName])
  @@index([createdAt])
  @@map("product_events")
}


model StageSystemSetting {
  id              Int      @id @default(autoincrement())
  key             String   @unique @db.VarChar(100)
  value           String   @default("") @db.VarChar(500)
  valueType       String   @default("string") @map("value_type") @db.VarChar(30)
  description     String   @default("") @db.VarChar(300)
  updatedByUserId Int?     @map("updated_by_user_id")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  @@map("system_settings")
}

// D1: Python RestaurantEmployee model with deterministic unique membership.
// Membership does not change the global AuthUser role or grant KDS access.
model MarketplaceRestaurantEmployee {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  userId       Int      @map("user_id")
  role         String   @default("cashier") @db.VarChar(30)
  restaurant   MarketplaceRestaurant @relation(fields:[restaurantId],references:[id],onDelete:Cascade)
  user         AuthUser @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([restaurantId,userId],map:"uq_restaurant_employee_membership")
  @@index([restaurantId])
  @@index([userId])
  @@map("restaurant_employees")
}

  
// E1: functional customer platform contracts from Python platform.py.
// Staging-only data. Partial unique index on default addresses lives in SQL.
model PlatformAddress {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  label     String   @default("Casa") @db.VarChar(60)
  address   String   @db.VarChar(300)
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false) @map("is_default")
  user      AuthUser @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId])
  @@map("addresses")
}
model PlatformFavorite {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  restaurantId Int       @map("restaurant_id")
  user         AuthUser  @relation(fields:[userId],references:[id],onDelete:Cascade)
