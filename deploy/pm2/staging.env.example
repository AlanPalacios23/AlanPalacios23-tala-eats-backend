# EXAMPLE ONLY. Never commit a filled env file. Store the real file
# in ~/.config/talaeats-pm2-stage.env on the separate VPS (chmod 600).
# This uses strict production validation, but NOT live payment credentials.
ENVIRONMENT=production
DEBUG=false
DATABASE_URL=postgresql+psycopg://STAGE_USER:SET_PRIVATE_PASSWORD@127.0.0.1:5432/talaeats_stage
REDIS_URL=redis://127.0.0.1:6379/1
JWT_SECRET=GENERATE_A_PRIVATE_RANDOM_STRING_OF_AT_LEAST_40_CHARACTERS
ALLOWED_HOSTS=stage-api.example.com,127.0.0.1
CORS_ORIGINS=https://stage-api.example.com
PUBLIC_BASE_URL=https://stage-api.example.com
FRONTEND_URL=https://stage-api.example.com
MEDIA_DIR=/home/CHANGE_ME/talaeats-stage-media
SEED_DEMO_DATA=false
AUTO_MIGRATE_ON_START=false
MERCHANT_MANAGED_DELIVERY=false
DRIVER_OFFER_MODE=false
REQUIRE_ONLINE_PAYMENTS=false
STRIPE_ENABLED=false
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_SELF_SERVICE_ENABLED=false
WITHDRAWALS_PREVIEW_ENABLED=false
WITHDRAWALS_EXECUTION_ENABLED=false
WITHDRAWALS_LIVE_ENABLED=false
CASH_CHECKOUT_ENABLED=false
MERCADO_PAGO_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
